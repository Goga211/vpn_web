REMNAWAVE_USERNAME=
REMNAWAVE_PASSWORD=
REMNAWAVE_TOKEN=
REMNAWAVE_USER_TAG=WEB
REMNAWAVE_INTERNAL_SQUADS=
REMNAWAVE_TIMEOUT=12s

# Online checkout switch.
CHECKOUT_ENABLED=true
